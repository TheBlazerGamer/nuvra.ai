# Banco de dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nuvra_ai?schema=public"

# Autenticação (clientes)
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="7d"

# Autenticação (equipe Nuvra / admin) — segredo separado do dos clientes de propósito
STAFF_JWT_SECRET="troque-por-outro-segredo-forte"
STAFF_JWT_EXPIRES_IN="12h"

# Bootstrap do primeiro usuário admin via prisma:seed (opcional, só roda se ambos estiverem definidos)
ADMIN_NOME="Equipe Nuvra"
ADMIN_EMAIL=""
ADMIN_SENHA=""

# DigitalOcean Spaces
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
DO_SPACES_BUCKET=""
DO_SPACES_REGION="nyc3"
DO_SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"

# Anthropic (Claude)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Meta Marketing API
META_APP_ID=""
META_APP_SECRET=""
META_SYSTEM_USER_TOKEN=""
META_BUSINESS_MANAGER_ID=""

# n8n (webhooks de automação)
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

PORT=3001
