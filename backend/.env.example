# Nuvra.AI backend — variáveis de ambiente (modelo; copie para .env e nunca versione o .env)

NODE_ENV=development
PORT=3001
# Origem do site (CORS e checagem anti-CSRF). Em produção: https://app.<domínio da Nuvra>
WEB_ORIGIN=http://localhost:3000
# Quantos proxies reversos (Traefik/Nginx) existem entre a internet e a API. 0 em desenvolvimento, 1 em produção.
# Errado = todos os clientes parecem ter o mesmo IP e o limite de tentativas de login pega todo mundo junto.
TRUST_PROXY=0
# Máximo de tentativas de login/cadastro por IP por minuto (padrão 10).
# AUTH_RATE_LIMIT_PER_MIN=10

# --- Banco de dados: UM Postgres, isolamento por cliente via Row Level Security ---
# Três papéis com permissões diferentes (as senhas ficam DENTRO das URLs; use valores longos e aleatórios):
#  - nuvra_owner : só para migrations (deploy). O servidor da API nunca usa.
#  - nuvra_app   : tráfego do cliente. Sujeito ao RLS: só enxerga as linhas do próprio cliente.
#  - nuvra_system: autenticação, webhook do Telegram e rotinas em segundo plano (acesso total, uso restrito).
DB_OWNER_URL="postgresql://nuvra_owner:TROQUE_ESTA_SENHA@127.0.0.1:54329/nuvra"
DB_APP_URL="postgresql://nuvra_app:TROQUE_ESTA_SENHA@127.0.0.1:54329/nuvra"
DB_SYSTEM_URL="postgresql://nuvra_system:TROQUE_ESTA_SENHA@127.0.0.1:54329/nuvra"

# --- Telegram (bot criado no @BotFather; o token é segredo, preencha só no .env local/servidor) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
