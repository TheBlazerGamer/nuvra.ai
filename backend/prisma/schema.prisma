generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusCliente {
  ATIVO
  SUSPENSO
}

// Raiz do isolamento: toda tabela de dados de cliente tem cliente_id e RLS (ver migration "rls").
model Cliente {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String
  email        String        @unique
  senhaHash    String        @map("senha_hash")
  status       StatusCliente @default(ATIVO)
  bloqueadoAte DateTime?     @map("bloqueado_ate") @db.Timestamptz(6)
  emailVerificadoEm DateTime? @map("email_verificado_em") @db.Timestamptz(6)
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  sessoes        Sessao[]
  vinculosCanal  VinculoCanal[]
  tokensVinculoCanal TokenVinculoCanal[]
  tokensEmail    TokenEmail[]
  auditoria      EventoAuditoria[]
  conexaoMeta    ConexaoMeta?
  estadosOAuthMeta EstadoOAuthMeta[]

  @@map("clientes")
}

// O cookie do navegador guarda um token aleatório; aqui fica só o hash SHA-256 dele.
model Sessao {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId   String    @map("cliente_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz(6)
  ultimoUsoEm DateTime  @default(now()) @map("ultimo_uso_em") @db.Timestamptz(6)
  revogadaEm  DateTime? @map("revogada_em") @db.Timestamptz(6)
  userAgent   String?   @map("user_agent")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("sessoes")
}

// Canal-agnóstico de propósito (ver docs/plano-migracao-whatsapp.md): o Telegram é o primeiro canal,
// o WhatsApp entra depois sem precisar de tabela nova nem trocar o núcleo da conversa.
enum Canal {
  TELEGRAM
  WHATSAPP
}

// Uso único e curta duração: aparece só como link t.me/<bot>?start=<token>.
model TokenVinculoCanal {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId String    @map("cliente_id") @db.Uuid
  canal     Canal
  tokenHash String    @unique @map("token_hash")
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  expiraEm  DateTime  @map("expira_em") @db.Timestamptz(6)
  usadoEm   DateTime? @map("usado_em") @db.Timestamptz(6)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, canal, criadoEm])
  @@map("tokens_vinculo_canal")
}

model VinculoCanal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId   String   @map("cliente_id") @db.Uuid
  canal       Canal
  // Telegram: id numérico do usuário e do chat, como texto. WhatsApp (futuro): telefone em E.164.
  idExterno   String   @map("id_externo")
  chatId      String   @map("chat_id")
  vinculadoEm DateTime @default(now()) @map("vinculado_em") @db.Timestamptz(6)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, canal])
  @@unique([canal, idExterno])
  @@map("vinculos_canal")
}

enum TipoTokenMeta {
  USUARIO
  SISTEMA
}

// A conta de anúncio e a Página do cliente na Meta, ligadas via Facebook Login for Business.
// O token nunca é lido pelo papel do cliente (nem por coluna) — só o papel de sistema o usa,
// e sempre cifrado (ver MetaCriptografiaService). Uma conexão por cliente.
model ConexaoMeta {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId          String        @unique @map("cliente_id") @db.Uuid
  // ID do usuário na Meta (específico do nosso app): é como a Meta nos avisa QUEM removeu o app ou pediu exclusão.
  metaUserId         String?       @map("meta_user_id")
  tipoToken          TipoTokenMeta @map("tipo_token")
  tokenCriptografado String        @map("token_criptografado")
  contaAnuncioId     String?       @map("conta_anuncio_id")
  contaAnuncioNome   String?       @map("conta_anuncio_nome")
  paginaId           String?       @map("pagina_id")
  paginaNome         String?       @map("pagina_nome")
  expiraEm           DateTime?     @map("expira_em") @db.Timestamptz(6)
  conectadoEm        DateTime      @default(now()) @map("conectado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([metaUserId])
  @@map("conexoes_meta")
}

// CSRF do login com a Meta: o "state" que mandamos no início do OAuth e conferimos na volta.
// Uso único e curta duração, só o papel de sistema acessa (o cliente nunca lê nem grava aqui).
model EstadoOAuthMeta {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId  String    @map("cliente_id") @db.Uuid
  estadoHash String    @unique @map("estado_hash")
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  expiraEm   DateTime  @map("expira_em") @db.Timestamptz(6)
  usadoEm    DateTime? @map("usado_em") @db.Timestamptz(6)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, criadoEm])
  @@map("estados_oauth_meta")
}

// Trilha de auditoria para a revisão de segurança externa. Só o papel "system" lê e escreve.
model EventoAuditoria {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId String?  @map("cliente_id") @db.Uuid
  tipo      String
  detalhes  Json     @default("{}")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([clienteId, criadoEm])
  @@index([tipo, criadoEm])
  @@map("eventos_auditoria")
}

enum TipoTokenEmail {
  VERIFICACAO_EMAIL
  RECUPERACAO_SENHA
}

// Uso único: guardamos só o hash; o token em si só existe no e-mail enviado ao cliente.
model TokenEmail {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId String         @map("cliente_id") @db.Uuid
  tipo      TipoTokenEmail
  tokenHash String         @unique @map("token_hash")
  criadoEm  DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  expiraEm  DateTime       @map("expira_em") @db.Timestamptz(6)
  usadoEm   DateTime?      @map("usado_em") @db.Timestamptz(6)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, tipo, criadoEm])
  @@map("tokens_email")
}
